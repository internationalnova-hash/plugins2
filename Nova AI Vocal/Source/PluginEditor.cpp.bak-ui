#include "PluginEditor.h"
#include "BinaryData.h"

#include <cstring>

NovaAIVocalEditor::NovaAIVocalEditor (NovaAIVocalProcessor& p)
    : AudioProcessorEditor (&p), processorRef (p)
{
    webView = std::make_unique<SinglePageBrowser> (createWebOptions (*this));

    auto& s = processorRef.apvts;
    cleanAttachment  = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("clean"),  cleanRelay,  nullptr);
    deessAttachment  = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("deess"),  deessRelay,  nullptr);
    punchAttachment  = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("punch"),  punchRelay,  nullptr);
    airAttachment    = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("air"),    airRelay,    nullptr);
    warmthAttachment = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("warmth"), warmthRelay, nullptr);
    spaceAttachment  = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("space"),  spaceRelay,  nullptr);
    tuneAttachment   = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("tune"),   tuneRelay,   nullptr);
    keyAttachment    = std::make_unique<juce::WebComboBoxParameterAttachment> (*s.getParameter ("key"), keyRelay, nullptr);
    mixAttachment    = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("mix"),    mixRelay,    nullptr);
    outputAttachment = std::make_unique<juce::WebSliderParameterAttachment> (*s.getParameter ("output"), outputRelay, nullptr);
    vibeAttachment   = std::make_unique<juce::WebComboBoxParameterAttachment> (*s.getParameter ("vibe"), vibeRelay, nullptr);
    bypassAttachment = std::make_unique<juce::WebToggleButtonParameterAttachment> (*s.getParameter ("bypass"), bypassRelay, nullptr);

    addAndMakeVisible (*webView);

    const auto cacheBustedUrl = juce::WebBrowserComponent::getResourceProviderRoot()
                              + "/index.html?v=" + juce::String (juce::Time::getCurrentTime().toMilliseconds());
    webView->goToURL (cacheBustedUrl);

    setResizable (true, true);
    setResizeLimits (300, 360, 1000, 1200);
    setSize (500, 600);
    startTimerHz (30);
}

NovaAIVocalEditor::~NovaAIVocalEditor()
{
    stopTimer();
}

void NovaAIVocalEditor::paint (juce::Graphics& g)
{
    g.fillAll (juce::Colour::fromRGB (8, 8, 10));
}

void NovaAIVocalEditor::resized()
{
    if (webView != nullptr)
        webView->setBounds (getLocalBounds());
}

void NovaAIVocalEditor::timerCallback()
{
    if (webView == nullptr) return;

    juce::String state;
    switch (processorRef.getListenState())
    {
        case NovaVocalListenState::Idle:      state = "Idle"; break;
        case NovaVocalListenState::Listening: state = "Listening"; break;
        case NovaVocalListenState::Analyzing: state = "Analyzing"; break;
        case NovaVocalListenState::Mixed:     state = "Mixed"; break;
    }

    auto* obj = new juce::DynamicObject();
    obj->setProperty ("state", state);
    obj->setProperty ("summary", processorRef.getSummary());
    obj->setProperty ("captured", processorRef.getCapturedSeconds());
    obj->setProperty ("inDb", processorRef.getInputLevelDb());
    obj->setProperty ("outDb", processorRef.getOutputLevelDb());
    obj->setProperty ("compGr", processorRef.getCompGrDb());
    obj->setProperty ("deessGr", processorRef.getDeEssGrDb());
    obj->setProperty ("inMidi", processorRef.getTunerInputMidi());
    obj->setProperty ("targetMidi", processorRef.getTunerTargetMidi());
    obj->setProperty ("keyName", processorRef.getActiveKeyName());

    webView->emitEventIfBrowserIsVisible ("novaStatus", juce::var (obj));
}

juce::WebBrowserComponent::Options NovaAIVocalEditor::createWebOptions (NovaAIVocalEditor& editor)
{
    auto options = juce::WebBrowserComponent::Options {};

   #if JUCE_WINDOWS
    options = options.withBackend (juce::WebBrowserComponent::Options::Backend::webview2)
                     .withWinWebView2Options (
                         juce::WebBrowserComponent::Options::WinWebView2 {}
                             .withUserDataFolder (juce::File::getSpecialLocation (juce::File::tempDirectory)
                                 .getChildFile ("NovaAIVocal")));
   #endif

    options = options.withNativeIntegrationEnabled()
                     .withResourceProvider ([&editor] (const juce::String& url) { return editor.getResource (url); })
                     .withNativeFunction ("toggleListen", [&editor] (const juce::Array<juce::var>&, juce::WebBrowserComponent::NativeFunctionCompletion completion)
                     {
                         editor.processorRef.toggleListen();
                         completion (juce::var());
                     })
                     .withOptionsFrom (editor.cleanRelay)
                     .withOptionsFrom (editor.deessRelay)
                     .withOptionsFrom (editor.punchRelay)
                     .withOptionsFrom (editor.airRelay)
                     .withOptionsFrom (editor.warmthRelay)
                     .withOptionsFrom (editor.spaceRelay)
                     .withOptionsFrom (editor.tuneRelay)
                     .withOptionsFrom (editor.keyRelay)
                     .withOptionsFrom (editor.mixRelay)
                     .withOptionsFrom (editor.outputRelay)
                     .withOptionsFrom (editor.vibeRelay)
                     .withOptionsFrom (editor.bypassRelay);

    return options;
}

std::optional<juce::WebBrowserComponent::Resource> NovaAIVocalEditor::getResource (const juce::String& url)
{
    auto makeResource = [] (const void* data, int size, const char* mime)
    {
        std::vector<std::byte> bytes (static_cast<size_t> (size));
        std::memcpy (bytes.data(), data, static_cast<size_t> (size));
        return juce::WebBrowserComponent::Resource { std::move (bytes), juce::String (mime) };
    };

    // Substring match on the raw URL - same proven pattern as Nova AI Master.
    const auto lowerUrl = url.toLowerCase();

    if (lowerUrl.contains ("juce/index.js"))
        return makeResource (nova_ai_vocal_BinaryData::index_js2, nova_ai_vocal_BinaryData::index_js2Size, "text/javascript");

    if (lowerUrl.contains ("juce/check_native_interop.js"))
        return makeResource (nova_ai_vocal_BinaryData::check_native_interop_js, nova_ai_vocal_BinaryData::check_native_interop_jsSize, "text/javascript");

    if (lowerUrl.contains ("js/index.js"))
        return makeResource (nova_ai_vocal_BinaryData::index_js, nova_ai_vocal_BinaryData::index_jsSize, "text/javascript");

    if (lowerUrl.contains ("index.html") || lowerUrl.endsWith ("/") || lowerUrl.isEmpty())
        return makeResource (nova_ai_vocal_BinaryData::index_html, nova_ai_vocal_BinaryData::index_htmlSize, "text/html");

    return std::nullopt;
}
